{
  "name": "appium-wdio-jasmine-mobile-framework",
  "version": "1.0.0",
  "description": "Production-grade Mobile Test Automation Framework using WebdriverIO, Appium, Jasmine, and Page/Screen Object Model (POM)",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test:android": "wdio run ./config/wdio.android.conf.js",
    "test:android:smoke": "wdio run ./config/wdio.android.conf.js --suite smoke",
    "test:android:e2e": "wdio run ./config/wdio.android.conf.js --suite e2e",
    "test:ios": "wdio run ./config/wdio.ios.conf.js",
    "test:ios:smoke": "wdio run ./config/wdio.ios.conf.js --suite smoke",
    "test:ios:e2e": "wdio run ./config/wdio.ios.conf.js --suite e2e",
    "test:bs:android": "wdio run ./config/wdio.bs.conf.js",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "lint": "eslint src/ config/",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
  "keywords": [
    "webdriverio",
    "appium",
    "jasmine",
    "mobile-automation",
    "sdet",
    "android",
    "ios",
    "page-object-model"
  ],
  "author": "SDET Lead",
  "license": "MIT",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/jasmine-framework": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "allure-commandline": "^2.32.0",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0"
  }
}
